{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "angular-template": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "sass"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "allowedCommonJsDependencies": [
              "ace-builds",
              "uuid-js/lib/uuid.js"
            ],
            "outputPath": "deploy/app",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "sass",
            "assets": [
              "src/assets",
              {
                "input": "node_modules/animate.css/",
                "glob": "animate.min.css",
                "output": "assets/css/"
              },
              {
                "input": "node_modules/xterm/css/",
                "glob": "xterm.css",
                "output": "assets/css/"
              },
              {
                "input": "node_modules/xterm/lib/",
                "glob": "xterm.js",
                "output": "assets/js/"
              },
              {
                "input": "node_modules/jquery/dist/",
                "glob": "jquery.min.js",
                "output": "assets/js/"
              },
              {
                "input": "node_modules/echarts/dist/",
                "glob": "echarts.min.js",
                "output": "assets/js/"
              },
              {
                "input": "node_modules/socket.io-client/dist/",
                "glob": "socket.io.js",
                "output": "assets/js/"
              },
              {
                "input": "node_modules/datatables.net/js/",
                "glob": "jquery.dataTables.js",
                "output": "assets/js/"
              },
              {
                "input": "node_modules/bootstrap/dist/js/",
                "glob": "bootstrap.min.js",
                "output": "assets/js/"
              },
              {
                "input": "node_modules/bootstrap/dist/css/",
                "glob": "bootstrap.min.css",
                "output": "assets/css/"
              },
              {
                "input": "node_modules/datatables.net-dt/css/",
                "glob": "jquery.dataTables.min.css",
                "output": "assets/css/"
              },
              {
                "input": "node_modules/datatables.net-dt/images/",
                "glob": "*.png",
                "output": "assets/images/"
              },
              {
                "input": "node_modules/ace-builds/src-min-noconflict/",
                "glob": "**",
                "output": "assets/ace/"
              },
              {
                "input": "node_modules/metro4/build/css/",
                "glob": "metro-all.min.css",
                "output": "assets/css/"
              },
              {
                "input": "node_modules/metro4/build/js/",
                "glob": "metro.min.js",
                "output": "assets/js/"
              },
              {
                "input": "node_modules/metro4/build/mif/",
                "glob": "**",
                "output": "assets/mif/"
              }
            ],
            "styles": [
              "./node_modules/ng-zorro-antd/ng-zorro-antd.min.css",
              "src/sass/styles.sass"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "angular-template:build:production"
            },
            "development": {
              "browserTarget": "angular-template:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "sass",
            "assets": [
              "src/assets"
            ],
            "styles": [
              "./node_modules/ng-zorro-antd/ng-zorro-antd.min.css",
              "src/sass/styles.sass"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}